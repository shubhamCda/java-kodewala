package com.kodewala.list.hash;

import java.util.HashSet;

public class HashSetExp {

	public static void main(String[] args) {
		
		HashSet<String> cities = new HashSet<String>();
		
		cities.add("BLR");
		cities.add("DL");
		cities.add("MUB");
		cities.add("AUR");
		cities.add("JP");
		cities.add(null);		
		cities.add("BLR");
		cities.add("RP");
		
		System.out.println("Cities:: " +cities);
		
	}
}
